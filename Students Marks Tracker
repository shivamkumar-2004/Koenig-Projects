let students = [
    { id: 101, name: "Aarav", marks: [78, 85, 90], feedback: "Excellent" },
    { id: 102, name: "Diya", marks: [65, 72, 68], feedback: "Good" },
    { id: 103, name: "Rohan", marks: [90, 88, 95], feedback: "Excellent" }
];

// 1. Calculate Total Marks

function calculateTotal(marks) {
    let total = 0;

    for (let mark of marks) {
        total = total + mark;
    }

    return total;
}

// 2. Calculate Average

function calculateAverage(marks) {
    if (marks.length === 0) {
        return 0;
    }

    let total = calculateTotal(marks);

    return total / marks.length;
}

// 3. Find Highest Performer

function findHighestPerformer() {

    if (students.length === 0) {
        return null;
    }

    let highest = students[0];

    for (let student of students) {

        if (
            calculateAverage(student.marks) >
            calculateAverage(highest.marks)
        ) {
            highest = student;
        }
    }

    return highest;
}

// 4. Search Student by ID

function searchStudent(id) {

    for (let student of students) {

        if (student.id === id) {
            return student;
        }
    }

    return null;
}

// 5. Insert New Student

function insertStudent(student) {
    students.push(student);
}

// 6. Delete Student

function deleteStudent(id) {

    for (let i = 0; i < students.length; i++) {

        if (students[i].id === id) {

            students.splice(i, 1);

            return true;
        }
    }

    return false;
}

// 7. Traverse Marks

function traverseMarks() {

