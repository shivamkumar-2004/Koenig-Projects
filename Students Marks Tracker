        console.log(student.name);

        for (let mark of student.marks) {
            console.log(mark);
        }
    }
}

// 8. Character Frequency

function characterFrequency() {

    let frequency = {};

    for (let student of students) {

        let text = student.feedback.toLowerCase();

        for (let char of text) {

            // Ignore spaces
            if (char === " ") {
                continue;
            }

            if (frequency[char] === undefined) {
                frequency[char] = 1;
            }
            else {
                frequency[char]++;
            }
        }
    }

    return frequency;
}

// 9. Most Frequent Character

function mostFrequentCharacter(frequency) {

    let maxCharacter = "";
    let maxCount = 0;

    for (let char in frequency) {

        if (frequency[char] > maxCount) {

            maxCount = frequency[char];
            maxCharacter = char;
        }
    }

    return [maxCharacter, maxCount];
}

// 10. Divisibility

function checkDivisibility(number) {

    console.log("Number:", number);

    console.log("Divisible by 2:", number % 2 === 0);
    console.log("Divisible by 3:", number % 3 === 0);
    console.log("Divisible by 5:", number % 5 === 0);
    console.log("Divisible by 7:", number % 7 === 0);
}

// 11. Prime Number

function isPrime(number) {

    if (number < 2) {
        return false;
    }

    for (let i = 2; i <= Math.sqrt(number); i++) {

        if (number % i === 0) {
            return false;
        }
    }

    return true;
}

// 12. GCD

function gcd(a, b) {

    while (b !== 0) {

        let remainder = a % b;

        a = b;
        b = remainder;
    }

    return Math.abs(a);
}

// 13. LCM

function lcm(a, b) {

    if (a === 0 || b === 0) {
        return 0;
    }

    return Math.abs(a * b) / gcd(a, b);
}

// 14. Performance Pattern

function performancePattern(n) {

    for (let i = 1; i <= n; i++) {

        let pattern = "";

        for (let j = 1; j <= i; j++) {

            pattern = pattern + "*";
        }

        console.log(pattern);
    }
}

// 15. Reverse Marks In-Place

function reverseMarks(marks) {

    let left = 0;
    let right = marks.length - 1;

    while (left < right) {

        let temp = marks[left];

        marks[left] = marks[right];
        marks[right] = temp;

        left++;
        right--;
    }
}

